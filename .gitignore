# dependencies
node_modules/

# build output
dist/
app/dist/
coverage/
*.tsbuildinfo
.eslintcache

# generated at build time from ../data by app/scripts/sync-data.mjs
app/public/data/
app/src/generated/

# vercel (created by `vercel link` / `vercel pull` / `vercel build`)
.vercel/

# scraper working files (raw HTML cache, never committed)
scraper/cache/

# environment files
.env
.env.*
!.env.example

# logs and OS noise
*.log
npm-debug.log*
.DS_Store
Thumbs.db

# large raw GIS downloads (regenerate with geo/build.mjs)
geo/raw/
geo/cache/

# geo: mapshaper temp dir (geo/raw/ and geo/cache/ are ignored above; geo/README.md has the
# re-download commands for every raw file)
geo/.build-tmp/

# print-source pipeline: Internet Archive OCR downloads (re-create with print/fetch.mjs)
print/raw/
print/.venv/
.vercel
.env*

# Playwright artifacts
app/e2e-results/
app/playwright-report/
app/test-results/

# OMR research working files
omr/cache/
omr/.venv/

omr/.venv*/
omr/samples/**/*.onnx
# cylinder legibility run (audio/run_legibility.py): audit log, failures, downloaded audio, venv
audio/out/
audio/cache/
audio/.venv/
.venv/

# raw HTML cache of the Australia scraper (never committed)
australia/scraper/cache/

# Australia collection: raw parse output, geo caches (GeoNames dump, Wikidata results), build output
australia/scraper/raw/
australia/geo/cache/
australia/app/dist/
australia/app/dist-e2e/
australia/app/public/data/
australia/app/src/generated/
australia/app/e2e-results/
australia/app/e2e-report/
australia/app/test-results/

# Python bytecode
__pycache__/
*.pyc
